<?xml version="1.0" encoding="utf-8"?>
<!--
    T-E10-06 (#227): Privacy-safe default backup policy.

    Pocket Ledger does not yet implement the optional backup-ready profile from
    #81. Until that exists, automatic Android backup must not include local
    ledger data, encrypted preference files, local-only settings, debug output,
    logs, generated reports, temporary files, or cache-like data.

    This file is used by android:fullBackupContent on Android versions before
    Android 12. Android 12+ uses data_extraction_rules.xml.
-->
<full-backup-content>
    <!-- Deny all app-private roots by default. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />

    <!-- Deny device-protected storage as well as credential-protected storage. -->
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />

    <!-- Ledger Room database and SQLite sidecar files contain personal finance data. -->
    <exclude domain="database" path="pocket-ledger.db" />
    <exclude domain="database" path="pocket-ledger.db-shm" />
    <exclude domain="database" path="pocket-ledger.db-wal" />
    <exclude domain="database" path="pocket-ledger.db-journal" />

    <!-- Encrypted preferences depend on Android Keystore state and stay local-only. -->
    <exclude domain="sharedpref" path="pocket_ledger_sensitive_prefs.xml" />

    <!-- Explicit review markers for cache, log, temp, debug, and generated artifacts. -->
    <exclude domain="root" path="cache/" />
    <exclude domain="root" path="code_cache/" />
    <exclude domain="root" path="no_backup/" />
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="logs/" />
    <exclude domain="file" path="log/" />
    <exclude domain="file" path="tmp/" />
    <exclude domain="file" path="temp/" />
    <exclude domain="file" path="debug/" />
    <exclude domain="file" path="reports/" />
    <exclude domain="file" path="generated/" />
    <exclude domain="external" path="cache/" />
    <exclude domain="external" path="logs/" />
    <exclude domain="external" path="tmp/" />
    <exclude domain="external" path="reports/" />
</full-backup-content>
