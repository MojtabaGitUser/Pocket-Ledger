<?xml version="1.0" encoding="utf-8"?>
<!--
    T-E10-06 (#227): Android 12+ data extraction policy.

    Cloud backup and device-to-device transfer both use deny-by-default rules
    because Pocket Ledger has not implemented the optional backup-ready profile
    from #81. The local Room ledger database is app-private but not encrypted by
    Pocket Ledger, so it is excluded from automatic extraction.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Deny all app-private roots by default for cloud backup. -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />

        <!-- Ledger data and SQLite sidecars contain personal finance data. -->
        <exclude domain="database" path="pocket-ledger.db" />
        <exclude domain="database" path="pocket-ledger.db-shm" />
        <exclude domain="database" path="pocket-ledger.db-wal" />
        <exclude domain="database" path="pocket-ledger.db-journal" />

        <!-- Keep local-only encrypted preferences out of cloud backup. -->
        <exclude domain="sharedpref" path="pocket_ledger_sensitive_prefs.xml" />

        <!-- Cache, log, temp, debug, and generated artifact review markers. -->
        <exclude domain="root" path="cache/" />
        <exclude domain="root" path="code_cache/" />
        <exclude domain="root" path="no_backup/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="log/" />
        <exclude domain="file" path="tmp/" />
        <exclude domain="file" path="temp/" />
        <exclude domain="file" path="debug/" />
        <exclude domain="file" path="reports/" />
        <exclude domain="file" path="generated/" />
        <exclude domain="external" path="cache/" />
        <exclude domain="external" path="logs/" />
        <exclude domain="external" path="tmp/" />
        <exclude domain="external" path="reports/" />
    </cloud-backup>

    <device-transfer>
        <!-- Device-to-device transfer follows the same local-only default. -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
        <exclude domain="database" path="pocket-ledger.db" />
        <exclude domain="database" path="pocket-ledger.db-shm" />
        <exclude domain="database" path="pocket-ledger.db-wal" />
        <exclude domain="database" path="pocket-ledger.db-journal" />
        <exclude domain="sharedpref" path="pocket_ledger_sensitive_prefs.xml" />
        <exclude domain="root" path="cache/" />
        <exclude domain="root" path="code_cache/" />
        <exclude domain="root" path="no_backup/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="log/" />
        <exclude domain="file" path="tmp/" />
        <exclude domain="file" path="temp/" />
        <exclude domain="file" path="debug/" />
        <exclude domain="file" path="reports/" />
        <exclude domain="file" path="generated/" />
        <exclude domain="external" path="cache/" />
        <exclude domain="external" path="logs/" />
        <exclude domain="external" path="tmp/" />
        <exclude domain="external" path="reports/" />
    </device-transfer>
</data-extraction-rules>
